# Copy this file to .env and fill in your own values. Never commit .env.

# Microsoft Graph app registration (your IT team provides these)
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000

# Passwords for protected PDFs, comma separated (often a tax ID or account number)
PDF_PASSWORDS=

# Optional: local AI backup extraction with Ollama (1 = on, 0 = off)
USE_LOCAL_AI=0
LOCAL_AI_MODEL=qwen2.5:3b

# Optional: path to tesseract.exe if it is not on your PATH (OCR for scanned PDFs)
TESSERACT_CMD=
